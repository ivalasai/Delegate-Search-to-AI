{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "participant.schema.json",
  "title": "Participant",
  "type": "object",
  "required": [
    "participant_id",
    "participant_type",
    "arrival_tick",
    "energy_budget",
    "energy_remaining",
    "participation_style",
    "access_scope",
    "availability_windows",
    "problems_held",
    "solutions_held",
    "bounded_rationality_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "participant_id": { "type": "string" },
    "participant_type": {
      "type": "string",
      "enum": ["human", "algorithmic_agent"]
    },
    "arrival_tick": { "type": "integer", "minimum": 1 },
    "departure_tick": { "type": ["integer", "null"], "minimum": 1 },
    "energy_budget": { "type": "number", "exclusiveMinimum": 0 },
    "energy_remaining": { "type": "number", "minimum": 0 },
    "participation_style": {
      "type": "string",
      "enum": ["problem_driver", "solution_carrier", "bystander", "mixed"]
    },
    "access_scope": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "availability_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_tick", "end_tick"],
        "additionalProperties": false,
        "properties": {
          "start_tick": { "type": "integer", "minimum": 1 },
          "end_tick": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "problems_held": {
      "type": "array",
      "items": { "type": "string" }
    },
    "solutions_held": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preference_signals": { "type": ["object", "null"] },
    "bounded_rationality_profile": { "type": "null" }
  }
}
